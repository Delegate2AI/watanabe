# Copy to .env.local (development) or provide through your deployment.
# Every value below is a placeholder. Nothing here is a working credential.

# ---------------------------------------------------------------------------
# Configuration file
# ---------------------------------------------------------------------------

# Path to the YAML configuration. Defaults to ./portal.yaml when present.
# PORTAL_CONFIG=./portal.yaml

# ---------------------------------------------------------------------------
# Knowledge base repository
# ---------------------------------------------------------------------------

# Git host adapter: gitlab or github. Optional: a github.com REPO_URL selects github and any other host selects gitlab.
# Set it to github for GitHub Enterprise.
# GIT_HOST=github

# HTTPS URL of the knowledge base repository the portal clones, pushes branches to, and opens change requests against.
# REPO_URL=https://github.com/your-org/your-knowledge-base.git

# Token with read access to the repository. When set, the portal manages its own checkout and ignores LOCAL_REPO_PATH.
# REPO_READ_TOKEN=

# Token allowed to push branches and open change requests. Required for KB_WRITE_ENABLED.
# REPO_WRITE_TOKEN=

# Use an existing local checkout as the knowledge base. Only honored when REPO_READ_TOKEN is unset.
# LOCAL_REPO_PATH=/path/to/knowledge-base

# Directory inside the repository that holds the markdown vault. Empty means the repository root.
# VAULT_SUBDIR=docs

# Where the managed checkout is kept.
# REPO_CHECKOUT_DIR=.data/repo

# Where per-thread worktrees for edits are created.
# WORKTREE_ROOT=.data/worktrees

# Interval in milliseconds between background refreshes of the checkout.
# REPO_REFRESH_INTERVAL_MS=300000

# Shared secret that authorizes the push webhook which triggers a checkout refresh. Unset means the route is disabled.
# REPO_REFRESH_WEBHOOK_SECRET=

# Set to direct to push knowledge base edits straight to the default branch instead of opening a change request.
# KB_WRITE_MODE=

# Origin override for the private memory branch remote.
# MEMORY_ORIGIN_OVERRIDE=

# Where the private memory branch worktree is kept.
# MEMORY_CHECKOUT_DIR=.data/memory

# ---------------------------------------------------------------------------
# Authentication and access
# ---------------------------------------------------------------------------

# Required to start with auth.mode none in portal.yaml. Local evaluation only: it disables authentication.
# PORTAL_ALLOW_NO_AUTH=1

# Trust the x-dev-identity request header. Local development only.
# PORTAL_ALLOW_DEV_IDENTITY_HEADER=1

# Run every request as this identity when no other strategy resolves one. Local development only.
# DEV_IDENTITY_EMAIL=dev@example.com

# Shared secret the ingress injects so the proxy-header strategy can verify requests came through the proxy.
# PORTAL_PROXY_ASSERT_SECRET=

# OIDC client secret for auth.mode oidc.
# PORTAL_OIDC_CLIENT_SECRET=

# Secret of at least 32 characters used to sign session cookies for auth.mode oidc.
# PORTAL_SESSION_SECRET=

# Comma separated emails treated as administrators regardless of the role files.
# BOOTSTRAP_ADMINS=

# URL the sign-out control sends the browser to, for proxy-based sign-in.
# NEXT_PUBLIC_SIGN_OUT_URL=

# Public origin of this portal, used for connector OAuth redirect URIs when auth.oidc.baseUrl is not set.
# MCP_PUBLIC_ORIGIN=https://portal.example.com

# Bearer secret that authorizes calls to the scheduled job endpoint. Unset means the endpoint is disabled.
# CRON_SECRET=

# Base64 encoded 32 byte key that encrypts stored connector credentials.
# CONNECTOR_CRED_KEY=

# ---------------------------------------------------------------------------
# Assistant
# ---------------------------------------------------------------------------

# API key for the Claude Agent SDK when running outside a container. In a container use AGENT_CHAT_API_KEY or AGENT_CHAT_OAUTH_TOKEN.
# ANTHROPIC_API_KEY=

# Set to claude-code to run the assistant on a local Claude Code login instead of an API key.
# AGENT_AUTH_MODE=

# Credential and mode for a remote or containerized deployment.
# AGENT_CHAT_API_KEY=
# AGENT_CHAT_OAUTH_TOKEN=
# AGENT_CHAT_REMOTE=1

# Default model id, and an optional comma separated list users can switch between.
# AGENT_CHAT_MODEL=
# AGENT_CHAT_MODELS=

# Per-conversation limits.
# AGENT_MAX_TURNS=
# AGENT_MAX_BUDGET_USD=
# AGENT_MAX_WARM_SESSIONS=

# Where the Agent SDK stores session transcripts. Point at persistent storage in a container.
# CLAUDE_CONFIG_DIR=.data/claude

# Timeouts in milliseconds for background agent work.
# QUALITY_AGENT_TIMEOUT_MS=
# MEMORY_DREAM_TIMEOUT_MS=
# DESIGN_PREVIEW_TIMEOUT_MS=

# Limits for update packages.
# PACKAGES_DATA_DIR=.data/packages
# PACKAGES_MAX_BUDGET_USD=
# PACKAGES_MAX_ENTRY_COUNT=
# PACKAGES_MAX_FILE_BYTES=
# PACKAGES_MAX_TOTAL_BYTES=
# PACKAGES_MAX_TURNS=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite database file.
# PORTAL_DB_PATH=.data/portal.db

# How long SQLite waits on a locked database, in milliseconds.
# PORTAL_DB_BUSY_TIMEOUT_MS=

# Directories for generated and uploaded content.
# ASSETS_DIR=.data/assets
# ATTACHMENTS_DIR=.data/attachments
# PROJECT_DOCS_DIR=.data/project-docs
# INDEX_CACHE_DIR=.data/index
# AUTHORITY_PROJECTION_DIR=.data/projection
# DOC_RENDERS_DIR=.data/renders
# FONTS_DIR=.data/fonts

# Upload limits in bytes.
# ATTACHMENTS_MAX_BYTES=
# DOC_IMPORT_MAX_BYTES=
# DICTATION_MAX_BYTES=

# Installable skills: storage and size limits.
# PORTAL_SKILLS_DIR=.data/skills
# PORTAL_SKILLS_MAX_CLONE_BYTES=
# PORTAL_SKILLS_MAX_CLONE_ENTRIES=
# PORTAL_SKILLS_MAX_UPLOAD_BYTES=

# Set to 1 to enable the unified document store.
# UNIFIED_DOCS=1

# ---------------------------------------------------------------------------
# Optional services
# ---------------------------------------------------------------------------

# Document render sidecar (scripts/doc-render) used for PDF and HTML export.
# DOC_RENDER_URL=http://localhost:8791
# DOC_RENDER_CONCURRENCY=
# DOC_RENDER_DEBOUNCE_MS=
# DOC_RENDER_TIMEOUT_MS=

# Settings read by the render sidecar itself.
# RENDER_HOST=0.0.0.0
# RENDER_PORT=8791
# RENDER_MAX_BYTES=
# RENDER_NAV_TIMEOUT_MS=

# Speech-to-text backend (scripts/dictation-whisper) for the composer microphone.
# DICTATION_API_URL=http://localhost:8792
# DICTATION_API_KEY=

# Secret that authenticates incoming meeting webhooks.
# CIRCLEBACK_WEBHOOK_SECRET=

# Only ingest meetings whose name contains this text.
# MEETINGS_NAME_FILTER=

# LLM key service: the 9router admin endpoint, the gate sidecar (scripts/llm-gate), and the public base URL shown to users.
# LLM_ROUTER_URL=http://localhost:20128
# NINEROUTER_ADMIN_PASSWORD=
# LLM_GATE_URL=http://localhost:8793
# LLM_GATE_SECRET=
# LLM_PUBLIC_URL=https://llm.example.com

# Settings read by the llm-gate sidecar and its contract script.
# ROUTER_URL=http://localhost:20128
# ROUTER_PASSWORD=

# PostHog analytics. Both must be set for ANALYTICS_ENABLED to send anything.
# POSTHOG_HOST=https://posthog.example.com
# POSTHOG_KEY=

# Directory the demo seed script writes its sample vault to.
# DEMO_VAULT_DIR=.data/demo-vault

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Set a flag to 1 to turn the feature on. Admins can also override flags at runtime from the Flags tab.

# Stores and recalls durable agent memory from the private memory branch.
# MEMORY_ENABLED=1
# Builds and serves the generated knowledge base index.
# INDEX_ENABLED=1
# Shows the knowledge base link graph as a tab on the vault map.
# KB_GRAPH_ENABLED=1
# Runs automated quality checks before knowledge base submissions.
# QUALITY_GATES_ENABLED=1
# Flags duplicate or contradicting content against the rest of the knowledge base at submit time.
# INTEGRITY_ENABLED=1
# Accepts and processes update packages through the write path.
# PACKAGES_ENABLED=1
# Enables reviewable knowledge base edit and submission tools.
# KB_WRITE_ENABLED=1
# Applies group clearance to knowledge base reads and administration.
# AUTHORITY_ENABLED=1
# Enables meeting ingestion, processing, and meeting views.
# MEETINGS_ENABLED=1
# Sends pageviews, interactions, and client-side errors to the self-hosted PostHog, keyed by a pseudonymous id rather than a person's address.
# ANALYTICS_ENABLED=1
# Enables the combined activity feed and navigation entry.
# ACTIVITY_ENABLED=1
# Enables in-chat documents, canvas tools, and the canvas pane.
# CANVAS_ENABLED=1
# Lets the assistant author a document as a designed HTML page, and offers every document as PDF, HTML and Markdown.
# HTML_DOCUMENTS_ENABLED=1
# Allows thread-scoped file uploads for conversation context.
# ATTACHMENTS_ENABLED=1
# Enables voice transcription when a dictation backend is configured.
# DICTATION_ENABLED=1
# Lets admins edit which groups can see a knowledge base file or folder from the tree.
# KB_ACCESS_UI_ENABLED=1
# Names people from the private people directory instead of printing their email address.
# PEOPLE_ENABLED=1
# Lets admins map a person's other email addresses to their portal identity from the members list.
# ALIASES_ADMIN_ENABLED=1
# Enables the people activity view of who is doing what across meetings and tasks.
# PEOPLE_ACTIVITY_ENABLED=1
# Admin-registered external MCP servers, clearance-tagged, per-thread opt-in.
# CONNECTORS_ENABLED=1
# Per-user OAuth connections for external MCP connectors, the runtime kill switch for the connect flow, credential reads and bearer injection.
# CONNECTOR_OAUTH_ENABLED=1
# Admin-installed Agent Skills, clearance-tagged, loaded into chat sessions.
# SKILLS_ENABLED=1
# Offers a WYSIWYG alternative to the raw markdown source when editing a document body.
# RICH_EDITOR_ENABLED=1
# Accepts signed Circleback webhook deliveries, so meetings recorded by other workspace members can be ingested.
# MEETINGS_WEBHOOK_ENABLED=1
# Shows approvers the knowledge base changes waiting on review, and lets them merge or reject one.
# KB_REVIEW_ENABLED=1
# Lets an admin propose removing a knowledge base note, as a merge request into the review queue.
# KB_DELETE_ENABLED=1
# A chat panel on shared documents whose assistant proposes edits as suggestions for human review.
# DOC_COPILOT_ENABLED=1
# Records model usage and cost per turn and shows the ledger to administrators.
# USAGE_AUDIT_ENABLED=1
# Lets staff create their own LLM keys for coding harnesses, routed through a 9router sidecar under token budgets.
# LLM_KEYS_ENABLED=1
# Enables task extraction, task APIs, and task views.
# TASKS_ENABLED=1
# Enables discussion on tasks: a comment list on the task, a count on the cards, and comment activity in What's New.
# TASK_COMMENTS_ENABLED=1
# Enforces role-based capabilities for contributors and administrators.
# ROLES_ENABLED=1
# Enables project workspaces and project context in conversations.
# PROJECTS_ENABLED=1
# Enables saved artifacts and artifact publishing controls.
# ARTIFACTS_ENABLED=1
# Enables shared document creation, collaboration, and views.
# SHARED_DOCS_ENABLED=1
# Allows signed unauthenticated links to shared documents.
# EXTERNAL_SHARE_ENABLED=1
# Enables anchored comment threads and proposed edits on shared documents.
# DOC_ANNOTATIONS_ENABLED=1
# Lets a document be shared with a whole team, tracking that team's membership.
# DOC_GROUP_SHARING_ENABLED=1
# Lets a document owner submit a shared document to the knowledge base as a merge request.
# SHARED_DOC_PUBLISH_ENABLED=1
# Serves /api/mcp to members with an MCP client, and runs the OAuth authorization server that lets one register itself.
# MCP_ENABLED=1
# Lets a person drop a Markdown or Word file onto their shared documents to import it.
# DOC_IMPORT_ENABLED=1
# Shows a person who opens a document they are not on a "You need access" screen they can ask the owner from, instead of a bare not-found.
# DOC_ACCESS_REQUESTS_ENABLED=1
# Lets a contributor open a draft edit of a knowledge base note, which lands as a merge request.
# KB_PROPOSE_EDIT_ENABLED=1
